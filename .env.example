# ============================================================
# ESTIMATION PORTAL — one-click deploy config
# Copy to .env, fill in real values, then run ./setup.sh (or setup.ps1).
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────
# DATABASE_URL is set automatically by docker-compose (points at the db service).
# This password is what the db container and the api container both use.
POSTGRES_PASSWORD=change-me

# ── JWT Secrets ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email Delivery (Resend) ─────────────────────────────────
RESEND_API_KEY=put-your-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── File Storage ───────────────────────────────────────────
CF_ACCOUNT_ID=demo
CF_R2_ACCESS_KEY_ID=demo
CF_R2_SECRET_ACCESS_KEY=demo
CF_R2_BUCKET=demo-local

# ── Application ──────────────────────────────────────────
APP_BASE_URL=https://portal.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
ADMIN_EMAIL=admin@portal.com
COMPANY_NAME=ACE SERVICES
NODE_ENV=production

# Public URLs the browser calls directly — baked into the web build.
# Must match the Cloudflare Tunnel public hostnames below.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_WS_URL=https://api.yourdomain.com

# ── Cloudflare Tunnel ──────────────────────────────────────
# Zero Trust dashboard → Networks → Tunnels → your tunnel → Configure → copy the token.
# In the same dashboard, add Public Hostnames:
#   portal.yourdomain.com -> http://web:3000
#   api.yourdomain.com    -> http://api:4000
# Reuse the SAME token on every laptop that should be able to serve this stack.
CLOUDFLARE_TUNNEL_TOKEN=put-your-tunnel-token-here
